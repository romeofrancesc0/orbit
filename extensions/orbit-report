#!/usr/bin/env python3
"""Report a session to Orbit from any script, agent or hook.

Writes a file into the inbox (~/.orbit/inbox). The `inbox` provider picks it
up right away; Orbit needs to know nothing else about your agent.

    orbit-report --id build --title "Building the backend" \\
                    --status working --project api --path "$PWD" \\
                    --activity "docker build ."

    orbit-report --id build --status attention --activity "needs an answer"
    orbit-report --id build --remove

Valid statuses: working, attention, blocked, idle, ended, error.
"""

import argparse
import json
import os
import sys
import time

INBOX = os.path.expanduser(os.environ.get("ORBIT_INBOX", "~/.orbit/inbox"))


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--id", required=True, help="stable identifier of the session")
    parser.add_argument("--title")
    parser.add_argument("--project")
    parser.add_argument("--path")
    parser.add_argument("--branch")
    parser.add_argument("--model")
    parser.add_argument("--status", default="working")
    parser.add_argument("--activity")
    parser.add_argument("--detail")
    parser.add_argument("--provider", help="name shown instead of 'Inbox'")
    parser.add_argument("--accent", help="hex color, e.g. #8B5CF6")
    parser.add_argument("--tokens", type=int)
    parser.add_argument("--token-limit", type=int)
    parser.add_argument("--pid", type=int)
    parser.add_argument("--remove", action="store_true", help="remove the session from the notch")
    args = parser.parse_args()

    safe_id = "".join(c if c.isalnum() or c in "-_." else "-" for c in args.id)
    path = os.path.join(INBOX, safe_id + ".json")

    if args.remove:
        try:
            os.remove(path)
        except OSError:
            pass
        return 0

    payload = {
        "id": args.id,
        "status": args.status,
        "updatedAt": int(time.time() * 1000),
    }
    optional = {
        "title": args.title,
        "project": args.project,
        "path": args.path,
        "branch": args.branch,
        "model": args.model,
        "activity": args.activity,
        "detail": args.detail,
        "provider": args.provider,
        "accent": args.accent,
        "pid": args.pid,
    }
    payload.update({key: value for key, value in optional.items() if value is not None})

    if args.tokens is not None:
        payload["tokens"] = {"used": args.tokens}
        if args.token_limit is not None:
            payload["tokens"]["limit"] = args.token_limit

    os.makedirs(INBOX, exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False)
    os.replace(temporary, path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
